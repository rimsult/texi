{
  "name": "lexi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "content:build": "cd data-pipeline && python3 -m lexi_pipeline.build",
    "dev": "npm run dev -w @lexi/web",
    "build": "npm run build -w @lexi/web",
    "build:standalone": "npm run build:standalone -w @lexi/web",
    "typecheck": "tsc -b packages/core apps/web apps/api",
    "test": "npm run test:pipeline && npm run test:unit && npm run test:e2e",
    "test:pipeline": "cd data-pipeline && python3 -m pytest -q",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "build:e2e": "cd apps/web && VITE_API_URL=http://localhost:8787 npx vite build --outDir dist-e2e && npx vite build --mode standalone"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
