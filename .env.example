# ---- apps/web (Vercel → Project → Environment Variables) ----
# URL of the sync API. Leave empty to run fully local (progress stays on the device).
VITE_API_URL=https://lexi-api.onrender.com

# ---- apps/api (Render → Environment) ----
# Supabase: Project Settings → Database → Connection string (Session pooler, port 5432).
# Local Docker: postgres://lexi:lexi@localhost:5432/lexi
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Comma-separated origins allowed to call the API ("*" for any).
CORS_ORIGIN=https://lexi.vercel.app
PORT=8787
# Set to false to run migrations manually with `npm run migrate -w @lexi/api`.
AUTO_MIGRATE=true
