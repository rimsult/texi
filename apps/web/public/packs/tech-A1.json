{"schemaVersion":2,"deck":"tech","level":"A1","entries":[{"id":"tech:address-n","lemma":"address","pos":"noun","level":"A1","group":"noun.communication","domain":"it","definitions":[{"text":"the code that identifies where a piece of information is stored","lang":"en","source":"wordnet","quality":0.9},{"text":"код, который определяет, где хранится часть информации","lang":"ru","source":"machine","quality":0.7}],"translation":"адрес","synonyms":["reference"]},{"id":"tech:block-n","lemma":"block","pos":"noun","level":"A1","group":"noun.quantity","domain":"it","definitions":[{"text":"a sector or group of sectors that function as the smallest data unit permitted","lang":"en","source":"wordnet","quality":0.9},{"text":"сектор или группа секторов, которые функционируют как самая маленькая единица данных, разрешенная","lang":"ru","source":"machine","quality":0.7}],"example":"Since blocks are often defined as a single sector, the terms `block' and `sector' are sometimes used interchangeably.","exampleRu":"Поскольку блоки часто определяются как единый сектор, термины \"блок\" и \"сектор\" иногда используются взаимозаменяемо.","translation":"блок"},{"id":"tech:bus-n","lemma":"bus","pos":"noun","level":"A1","group":"noun.cognition","domain":"it","definitions":[{"text":"the topology of a network whose components are connected by a busbar","lang":"en","source":"wordnet","quality":0.9},{"text":"топология сети, компоненты которой соединены между собой баром","lang":"ru","source":"machine","quality":0.7}],"translation":"автобус, шина"},{"id":"tech:circle-n","lemma":"circle","pos":"noun","level":"A1","group":"noun.shape","domain":"math","definitions":[{"text":"ellipse in which the two axes are of equal length","lang":"en","source":"wordnet","quality":0.9},{"text":"эллипс, в котором две оси имеют одинаковую длину","lang":"ru","source":"machine","quality":0.7}],"example":"He calculated the circumference of the circle.","exampleRu":"Он вычислил окружность круга.","translation":"круг, окружность"},{"id":"tech:closed-adj","lemma":"closed","pos":"adjective","level":"A1","group":"adj:closed.a.02","hardGroup":"adjfam:closed.a.02","domain":"math","definitions":[{"text":"of an interval that contains both its endpoints","lang":"en","source":"wordnet","quality":0.9},{"text":"интервала, который содержит обе его конечные точки","lang":"ru","source":"machine","quality":0.7}],"translation":"закрытый, замкнутый"},{"id":"tech:code-n","lemma":"code","pos":"noun","level":"A1","group":"noun.communication","domain":"it","definitions":[{"text":"a way of storing or sending information, often secretly or in a way that is readable by computers","lang":"en","source":"simple","quality":0.95},{"text":"способ хранения или передачи информации, часто скрытно или доступным для чтения компьютерами","lang":"ru","source":"machine","quality":0.7}],"example":"In World War II, mathematicians and scientists broke the enemy's secret code.","exampleRu":"Во время Второй мировой войны математики и ученые взломали секретный код противника.","translation":"код"},{"id":"tech:computer-n","lemma":"computer","pos":"noun","level":"A1","group":"noun.artifact","domain":"it","definitions":[{"text":"a machine that helps you store, organize, and use information","lang":"en","source":"simple","quality":0.95},{"text":"машина, которая помогает вам хранить, организовывать и использовать информацию","lang":"ru","source":"machine","quality":0.7}],"example":"If you're looking at a web page, you must be using a computer.","exampleRu":"Если вы смотрите на веб-страницу, вы должны использовать компьютер.","translation":"компьютер, эвм"},{"id":"tech:difference-n","lemma":"difference","pos":"noun","level":"A1","group":"noun.quantity","domain":"math","definitions":[{"text":"the number that remains after subtraction","lang":"en","source":"wordnet","quality":0.9},{"text":"число, которое остается после вычитания","lang":"ru","source":"machine","quality":0.7}],"translation":"разница, разность","synonyms":["remainder"]},{"id":"tech:engineer-n","lemma":"engineer","pos":"noun","level":"A1","group":"noun.person","domain":"engineering","definitions":[{"text":"someone who is paid to solve technical problems, or to help invent things","lang":"en","source":"simple","quality":0.95},{"text":"кому платят за решение технических проблем или за помощь в изобретении вещей","lang":"ru","source":"machine","quality":0.7}],"translation":"инженер, инженерка, инженерша"},{"id":"tech:field-n","lemma":"field","pos":"noun","level":"A1","group":"noun.phenomenon","domain":"physics","definitions":[{"text":"the space around a radiating body within","lang":"en","source":"wordnet","quality":0.9},{"text":"пространство вокруг излучающего тела внутри","lang":"ru","source":"machine","quality":0.7}],"translation":"поле"},{"id":"tech:free-adj","lemma":"free","pos":"adjective","level":"A1","group":"adj:free.a.02","hardGroup":"adjfam:bound.a.02","domain":"physics","definitions":[{"text":"unconstrained or not chemically bound in a molecule or not fixed and capable of relatively unrestricted motion","lang":"en","source":"wordnet","quality":0.9},{"text":"неограниченный или химически не связанный в молекуле или не фиксированный и способный к относительно неограниченному движению","lang":"ru","source":"machine","quality":0.7}],"example":"A free electron.","exampleRu":"Свободный электрон.","translation":"свободный"},{"id":"tech:group-n","lemma":"group","pos":"noun","level":"A1","group":"noun.substance","domain":"chemistry","definitions":[{"text":"two or more atoms bound together as a single unit and forming part of a molecule","lang":"en","source":"wordnet","quality":0.9},{"text":"два или более атомов, связанных вместе как единое целое и образующих часть молекулы","lang":"ru","source":"machine","quality":0.7}],"translation":"группа","synonyms":["radical"]},{"id":"tech:internet-n","lemma":"internet","pos":"noun","level":"A1","group":"noun.artifact","domain":"it","definitions":[{"text":"any set of computer networks; an intranet","lang":"en","source":"simple","quality":0.95},{"text":"любой набор компьютерных сетей; интранет","lang":"ru","source":"machine","quality":0.7}],"synonyms":["net"]},{"id":"tech:light-n","lemma":"light","pos":"noun","level":"A1","group":"noun.phenomenon","domain":"physics","definitions":[{"text":"electromagnetic radiation that can produce a visual sensation","lang":"en","source":"wordnet","quality":0.9},{"text":"электромагнитное излучение, которое может создавать зрительные ощущения","lang":"ru","source":"machine","quality":0.7}],"example":"The light was filtered through a soft glass window.","exampleRu":"Свет фильтровался через мягкое стеклянное окно.","translation":"свет"},{"id":"tech:machine-n","lemma":"machine","pos":"noun","level":"A1","group":"noun.artifact","domain":"engineering","definitions":[{"text":"any mechanical or electrical device that transmits or modifies energy to perform or assist in the performance of human tasks","lang":"en","source":"wordnet","quality":0.9},{"text":"любое механическое или электрическое устройство, которое передает или модифицирует энергию для выполнения или оказания помощи в выполнении человеческих задач","lang":"ru","source":"machine","quality":0.7}],"translation":"машина, устройство, аппарат"},{"id":"tech:mobile-n","lemma":"mobile","pos":"noun","level":"A1","group":"noun.artifact","domain":"math","definitions":[{"text":"sculpture suspended in midair whose delicately balanced parts can be set in motion by air currents","lang":"en","source":"wordnet","quality":0.9},{"text":"скульптура, подвешенная в воздухе, чьи тонко сбалансированные части могут приводиться в движение воздушными потоками","lang":"ru","source":"machine","quality":0.7}]},{"id":"tech:plane-n","lemma":"plane","pos":"noun","level":"A1","group":"noun.shape","domain":"math","definitions":[{"text":"an unbounded two-dimensional shape","lang":"en","source":"wordnet","quality":0.9},{"text":"неограниченная двумерная форма","lang":"ru","source":"machine","quality":0.7}],"example":"We will refer to the plane of the graph as the X-Y plane.","exampleRu":"Мы будем называть плоскость графика плоскостью X-Y.","translation":"плоскость","synonyms":["sheet"]},{"id":"tech:star-n","lemma":"star","pos":"noun","level":"A1","group":"noun.object","domain":"physics","definitions":[{"text":"a celestial body of hot gases that radiates energy derived from thermonuclear reactions in the interior","lang":"en","source":"wordnet","quality":0.9},{"text":"небесное тело горячих газов, которое излучает энергию, полученную в результате термоядерных реакций внутри","lang":"ru","source":"machine","quality":0.7}],"translation":"звезда"},{"id":"tech:telephone-n","lemma":"telephone","pos":"noun","level":"A1","group":"noun.artifact","domain":"electrical","definitions":[{"text":"a machine used to talk to someone who is far away","lang":"en","source":"simple","quality":0.95},{"text":"машина, используемая для разговора с кем-то, кто находится далеко","lang":"ru","source":"machine","quality":0.7}],"example":"I need to find a telephone so I can tell my mother where I am.","exampleRu":"Мне нужно найти телефон, чтобы я мог сказать маме, где я нахожусь.","translation":"телефон","synonyms":["phone"]},{"id":"tech:wheel-n","lemma":"wheel","pos":"noun","level":"A1","group":"noun.artifact","domain":"engineering","definitions":[{"text":"a simple machine consisting of a circular frame with spokes that can rotate on a shaft or axle","lang":"en","source":"wordnet","quality":0.9},{"text":"простая машина, состоящая из круглой рамы со спицами, которые могут вращаться на валу или оси","lang":"ru","source":"machine","quality":0.7}],"translation":"колесо"},{"id":"tech:work-n","lemma":"work","pos":"noun","level":"A1","group":"noun.phenomenon","domain":"physics","definitions":[{"text":"force through a distance; this is how much energy you used to move something","lang":"en","source":"simple","quality":0.95},{"text":"сила на расстоянии; именно столько энергии вы использовали для того, чтобы что-то двигать","lang":"ru","source":"machine","quality":0.7}],"example":"Work equals force times distance.","exampleRu":"Работа равна силе и расстоянию.","translation":"работа"}],"questions":[{"trainer":"word-to-definition","entryId":"tech:address-n","lang":"ru","distractors":["tech:liter-n","tech:average-n","tech:temperature-n","tech:circle-n","tech:population-n"],"hard":["tech:software-n","tech:expression-n","tech:menu-n"]},{"trainer":"definition-to-word","entryId":"tech:address-n","lang":"ru","distractors":["tech:square-n","tech:brake-n","tech:atom-n","tech:ray-n","tech:wave-n"],"hard":["tech:software-n","tech:expression-n","tech:menu-n"]},{"trainer":"word-to-definition","entryId":"tech:address-n","lang":"en","distractors":["tech:light-n","tech:silver-n","tech:force-n","tech:bit-n","tech:bus-n"],"hard":["tech:software-n","tech:expression-n","tech:menu-n"]},{"trainer":"definition-to-word","entryId":"tech:address-n","lang":"en","distractors":["tech:sunlight-n","tech:kilometer-n","tech:bug-n","tech:solution-n","tech:plane-n"],"hard":["tech:software-n","tech:expression-n","tech:menu-n"]},{"trainer":"word-to-definition","entryId":"tech:block-n","lang":"ru","distractors":["tech:power-n","tech:code-n","tech:brake-n","tech:star-n","tech:planet-n"],"hard":["tech:bit-n","tech:inch-n","tech:degree-n","tech:meter-n","tech:liter-n"]},{"trainer":"definition-to-word","entryId":"tech:block-n","lang":"ru","distractors":["tech:salt-n","tech:machine-n","tech:system-n","tech:computer-n","tech:average-n"],"hard":["tech:bit-n","tech:inch-n","tech:degree-n","tech:meter-n","tech:liter-n"]},{"trainer":"word-to-definition","entryId":"tech:block-n","lang":"en","distractors":["tech:drill-n","tech:system-n","tech:engineer-n","tech:bus-n","tech:heat-n"],"hard":["tech:bit-n","tech:degree-n","tech:inch-n","tech:centimeter-n","tech:kilometer-n"]},{"trainer":"definition-to-word","entryId":"tech:block-n","lang":"en","distractors":["tech:wheel-n","tech:square-n","tech:star-n","tech:internet-n",